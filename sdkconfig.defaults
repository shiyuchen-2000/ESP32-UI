# Target: ESP32-S3
CONFIG_IDF_TARGET="esp32s3"

# Board: Waveshare ESP32-S3-Touch-LCD-1.85B (16MB QIO flash, 8MB octal PSRAM)
CONFIG_ESP_UI_BK_LIGHT_PWM=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# Audio (ES8311 codec in esp_codec_dev)
CONFIG_CODEC_ES8311_SUPPORT=y

# Timezone (POSIX TZ) for the NTP-synced clock
CONFIG_ESP_UI_TIMEZONE="CST-8"

# WiFi/GUI isolation: WiFi task on Core 1, GUI (LVGL) pinned to Core 0, so the
# display refresh never starves the WiFi ISR (avoid "Interrupt wdt timeout").
CONFIG_ESP_WIFI_TASK_PINNED_TO_CORE_1=y
CONFIG_ESP_EVENT_LOOP_TASK_STACK_SIZE=8192

# Display SPI + WiFi contention: a slightly relaxed interrupt watchdog avoids
# false positives under heavy display refresh.
CONFIG_ESP_INT_WDT_TIMEOUT_MS=1000

# LVGL configuration
CONFIG_LV_CONF_SKIP=y
CONFIG_LV_USE_QRCODE=y
CONFIG_LV_USE_OBSERVER=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_36=y
CONFIG_LV_FONT_MONTSERRAT_48=y
CONFIG_LV_USE_KEYBOARD=y

# Stack overflow detection (canary; default is already on, explicit here)
CONFIG_FREERTOS_CHECK_STACKOVERFLOW_CANARY=y

# Bluetooth: NimBLE peripheral for the MotoNav navigation link (unencrypted writes)
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
# CONFIG_BT_BLUEDROID_ENABLED is not set
# CONFIG_BT_NIMBLE_ROLE_CENTRAL is not set
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
# CONFIG_BT_NIMBLE_ROLE_OBSERVER is not set
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=517
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=4096
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y
